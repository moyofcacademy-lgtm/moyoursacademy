# --- Database ---------------------------------------------------------
# Postgres connection string (Neon/Supabase). Leave unset in local dev to
# use the embedded PGlite database in .pglite/ (run `npm run db:setup`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
# Optional direct (non-transaction-pooled) connection for Prisma migrations.
# Leave this unset rather than setting it to an empty value.
DIRECT_URL=""

# --- Auth (NextAuth v5) -------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudinary ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Email (Resend) ------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Moyours Academy <noreply@moyoursacademy.com>"
ADMIN_EMAIL="admin@moyoursacademy.com"


# --- Seed ------------------------------------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
